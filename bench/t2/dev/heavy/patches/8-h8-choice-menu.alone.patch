+    def format_choice(self, choice: t.Any) -> str:
+        """The text that prompts show for one choice: the name of an enum
+        member, ``str()`` of anything else.
+
+        .. versionadded:: 8.6
+        """
+        if isinstance(choice, enum.Enum):
+            return choice.name
+
+        return str(choice)
+
+    def choice_from_number(self, answer: str) -> _ValueT_co | None:
+        """The choice that a numbered menu answer selects: ``"1"`` is the
+        first choice. ``None`` when the answer is not a number of the menu.
+
+        .. versionadded:: 8.6
+        """
+        text = answer.strip()
+
+        if not text.isdigit():
+            return None
+
+        number = int(text)
+
+        if not 1 <= number <= len(self.choices):
+            return None
+
+        return self.choices[number - 1]
+
