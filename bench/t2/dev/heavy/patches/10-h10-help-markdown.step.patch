+class MarkdownHelpFormatter(HelpFormatter):
+    """Writes a help page as Markdown instead of terminal text. The command
+    formats its help as usual (:meth:`Command.format_help`), so every
+    section of ``--help`` is in the Markdown, in the same order:
+
+    -   the usage line becomes ``Usage: `cli [OPTIONS] NAME```,
+    -   texts (the help of the command, the epilog) become paragraphs,
+    -   a section heading becomes ``## Options``,
+    -   a definition list (options, arguments, commands) becomes a table
+        with the columns ``Name``, ``Description`` and ``Details``. The
+        name is code, the details are the items of the bracket at the end
+        of the help line (``default: 1; required``).
+
+    Blocks are separated by one blank line. Style codes are removed, text
+    is not wrapped, and ``|`` in a cell is escaped.
+
+    .. versionadded:: 8.6
+    """
+
+    _bracket = re.compile(r"(?s)^(?:(.*?)\s{2,})?\[([^\[\]]*)\]$")
+
+    def __init__(
+        self,
+        indent_increment: int = 2,
+        width: int | None = None,
+        max_width: int | None = None,
+        **kwargs: t.Any,
+    ) -> None:
+        super().__init__(indent_increment, width, max_width, **kwargs)
+        self.blocks: list[str] = []
+
+    def write(self, string: str) -> None:
+        """Raw text written by custom help code becomes a block of its own."""
+        text = strip_ansi(string).strip("\n")
+
+        if text.strip():
+            self.blocks.append(text)
+
+    def write_title(self, title: str) -> None:
+        """Writes the ``# title`` line, such as the command path."""
+        self.blocks.append(f"# {strip_ansi(title)}")
+
+    def write_usage(self, prog: str, args: str = "", prefix: str | None = None) -> None:
+        if prefix is None:
+            prefix = _("Usage:")
+
+        usage = f"{prog} {args}".strip()
+        self.blocks.append(f"{strip_ansi(prefix).strip()} `{strip_ansi(usage)}`")
+
+    def write_heading(self, heading: str) -> None:
+        self.blocks.append(f"## {strip_ansi(heading)}")
+
+    def write_paragraph(self) -> None:
+        pass
+
+    def write_text(self, text: str) -> None:
+        lines = [line for line in strip_ansi(text).splitlines() if line != "\b"]
+        paragraphs = "\n".join(line.strip() for line in lines).split("\n\n")
+
+        for paragraph in paragraphs:
+            if paragraph.strip():
+                self.blocks.append(paragraph.strip())
+
+    def write_dl(
+        self,
+        rows: cabc.Iterable[tuple[str, str]],
+        col_max: int = 30,
+        col_spacing: int = 2,
+        **kwargs: t.Any,
+    ) -> None:
+        lines = ["| Name | Description | Details |", "| --- | --- | --- |"]
+
+        for first, second in rows:
+            help, details = self.split_help(second)
+            name = f"`{self._cell(first)}`" if first else ""
+            lines.append(f"| {name} | {self._cell(help)} | {self._cell(details)} |")
+
+        self.blocks.append("\n".join(lines))
+
+    def split_help(self, text: str) -> tuple[str, str]:
+        """Splits a help line into its text and the items of the bracket at
+        its end: ``("The name.", "default: x; required")``.
+        """
+        text = strip_ansi(text).strip()
+        match = self._bracket.match(text)
+
+        if match is None:
+            return text, ""
+
+        return (match.group(1) or "").strip(), match.group(2).strip()
+
+    @staticmethod
+    def _cell(text: str) -> str:
+        return " ".join(strip_ansi(text).split()).replace("|", "\\|")
+
+    def getvalue(self) -> str:
+        return "\n\n".join(self.blocks) + "\n" if self.blocks else ""
+
+
