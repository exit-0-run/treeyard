+def append_help_extra(help: str, items: cabc.Sequence[str]) -> str:
+    """Appends the bracket of extra items to a help text, the way option
+    help lines show it: ``"Name.  [default: x; required]"``. Without
+    items the help text is returned as it is; without a help text the
+    bracket stands alone.
+
+    :param help: the help text, may be empty.
+    :param items: the texts of the items, in order.
+
+    .. versionadded:: 8.6
+    """
+    if not items:
+        return help
+
+    extra_str = "; ".join(items)
+    return f"{help}  [{extra_str}]" if help else f"[{extra_str}]"
+
+
