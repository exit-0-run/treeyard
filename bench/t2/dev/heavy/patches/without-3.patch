+"""The text of a prompt: what :func:`click.prompt` and :func:`click.confirm`
+show before they read an answer.
+
+The text is built from parts (the question, the choices, the default and the
+suffix) by :class:`PromptText`. Each part has its own method, so a subclass
+can change one part and keep the others.
+"""
+
+from __future__ import annotations
+
+import enum
+import io
+import typing as t
+
+from .types import Choice
+from .types import ParamType
+from .utils import _LazyFile
+
+V = t.TypeVar("V")
+
+
+def _format_default(default: V, type: object | None = None) -> V | str:
+    """The default as a prompt shows it: an enum member by its name, an
+    open file by its name, a value of a :class:`ParamType` as its
+    :meth:`~ParamType.format_value` text, anything else as it is.
+    """
+    if isinstance(default, enum.Enum):
+        return default.name
+
+    if isinstance(default, (io.IOBase, _LazyFile)):
+        name = getattr(default, "name", None)
+
+        if name is not None:
+            return str(name)
+
+    if isinstance(type, ParamType):
+        return type.format_value(default)
+
+    return default
+
+
+class PromptText:
+    """The text of one prompt, built from its parts.
+
+    ``PromptText("Name", ": ", default="alice").render()`` is
+    ``"Name [alice]: "``, exactly the text that
+    ``click.prompt("Name", default="alice")`` shows.
+
+    :param text: the question.
+    :param suffix: written after everything else, such as ``": "``.
+    :param show_default: show the default in brackets. A string is shown
+        in parentheses instead of the default itself.
+    :param default: the default value.
+    :param show_choices: list the choices of a :class:`Choice` type.
+    :param type: the type of the value that is asked for.
+    :param choice_menu: the choices of a :class:`Choice` type are shown as
+        a numbered menu: the text shows the range of numbers, ``(1-3)``,
+        and a default that is one of the choices as its number.
+
+    .. versionadded:: 8.6
+    """
+
+    def __init__(
+        self,
+        text: str,
+        suffix: str = ": ",
+        show_default: bool | str = False,
+        default: object | None = None,
+        show_choices: bool = True,
+        type: object | None = None,
+        choice_menu: bool = False,
+    ) -> None:
+        self.text = text
+        self.suffix = suffix
+        self.show_default = show_default
+        self.default = default
+        self.show_choices = show_choices
+        self.type = type
+        self.choice_menu = choice_menu
+
+    @classmethod
+    def for_confirm(
+        cls,
+        text: str,
+        default: bool | None = False,
+        suffix: str = ": ",
+        show_default: bool = True,
+    ) -> PromptText:
+        """The text of a yes/no question, as :func:`click.confirm` asks it:
+        the default is shown as ``y/n``, ``Y/n`` or ``y/N``.
+        """
