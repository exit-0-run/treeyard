 class NetworkXError(NetworkXException):
     """Exception for a serious error in NetworkX"""
+
+
+class LineParseError(NetworkXError, TypeError):
+    """Raised by the readers of the line formats (edge list, adjacency list,
+    multiline adjacency list, Pajek, LEDA) for a line they cannot read.
+
+    It is a :exc:`TypeError` and a :exc:`NetworkXError`, the kinds of errors
+    these readers raised before.
+
+    Attributes
+    ----------
+    message : str
+        What is wrong with the line.
+    lineno : int
+        The number of the line in the input, from 1; comment and blank lines
+        count.
+    line : str
+        The text of the line, without its line end.
+    filename : str or None
+        The name of the file, when the error comes from a ``read_*``
+        function that knows it.
+
+    ``str()`` of the error is ``"line <lineno>: <message>"``, or
+    ``"<filename>:<lineno>: <message>"`` when `filename` is set.
+    """
+
+    def __init__(self, message, lineno, line=None, filename=None):
+        super().__init__(message)
+        self.message = message
+        self.lineno = lineno
+        self.line = line.rstrip("\r\n") if isinstance(line, str) else line
+        self.filename = filename
+
+    def __str__(self):
+        where = (
+            f"{self.filename}:{self.lineno}" if self.filename else f"line {self.lineno}"
+        )
+        return f"{where}: {self.message}"
 
 
