+class _Numbered:
+    """An iterator over lines that knows the number (from 1) and the text of
+    the line it gave last."""
+
+    def __init__(self, lines):
+        self._it = iter(lines)
+        self.lineno = 0
+        self.line = None
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        self.line = next(self._it)
+        self.lineno += 1
+        return self.line
 
 
