{
  "set": "long",
  "agents": 9,
  "mix": [
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude"
  ],
  "limits": {
    "max_turns": 600,
    "max_tokens": 40000000,
    "timeout_s": 7200,
    "claude_budget_usd": 1.5
  },
  "sequential": true,
  "tasks": [
    "l1-quoted-names",
    "l2-graph-header",
    "l3-line-errors",
    "l4-output-format",
    "l5-file-bytes",
    "l6-compression",
    "l7-line-parser",
    "l8-line-writer",
    "l9-text-file"
  ],
  "integration": [
    {
      "id": "i1-parser-quoted-names",
      "pair": [
        7,
        1
      ],
      "test": "networkx/readwrite/tests/test_t2_i1_parser_quoted_names.py",
      "why": "refactor: l1's quoted names must be read by LineParser"
    },
    {
      "id": "i2-parser-graph-header",
      "pair": [
        7,
        2
      ],
      "test": "networkx/readwrite/tests/test_t2_i2_parser_graph_header.py",
      "why": "refactor: l2's header must be read by LineParser"
    },
    {
      "id": "i3-parser-line-errors",
      "pair": [
        7,
        3
      ],
      "test": "networkx/readwrite/tests/test_t2_i3_parser_line_errors.py",
      "why": "refactor: LineParser's methods raise l3's LineParseError"
    },
    {
      "id": "i4-parser-line-ends",
      "pair": [
        7,
        5
      ],
      "test": "networkx/readwrite/tests/test_t2_i4_parser_line_ends.py",
      "why": "refactor: LineParser.split drops l5's line ends"
    },
    {
      "id": "i5-writer-quoted-names",
      "pair": [
        8,
        1
      ],
      "test": "networkx/readwrite/tests/test_t2_i5_writer_quoted_names.py",
      "why": "refactor: LineWriter.name quotes l1's names"
    },
    {
      "id": "i6-writer-output-format",
      "pair": [
        8,
        4
      ],
      "test": "networkx/readwrite/tests/test_t2_i6_writer_output_format.py",
      "why": "refactor: l4's sort and float_format are LineWriter options"
    },
    {
      "id": "i7-writer-graph-header",
      "pair": [
        8,
        2
      ],
      "test": "networkx/readwrite/tests/test_t2_i7_writer_graph_header.py",
      "why": "refactor: l2's header and comments are LineWriter options"
    },
    {
      "id": "i8-file-graph-header",
      "pair": [
        9,
        2
      ],
      "test": "networkx/readwrite/tests/test_t2_i8_file_graph_header.py",
      "why": "refactor: l2's header line goes through TextFile.write_lines"
    },
    {
      "id": "i9-file-bytes",
      "pair": [
        9,
        5
      ],
      "test": "networkx/readwrite/tests/test_t2_i9_file_bytes.py",
      "why": "refactor: l5's byte order marks and line ends are TextFile's"
    },
    {
      "id": "i10-file-line-errors",
      "pair": [
        9,
        3
      ],
      "test": "networkx/readwrite/tests/test_t2_i10_file_line_errors.py",
      "why": "refactor: TextFile.read names the file of l3's errors"
    },
    {
      "id": "i11-file-compression",
      "pair": [
        9,
        6
      ],
      "test": "networkx/readwrite/tests/test_t2_i11_file_compression.py",
      "why": "refactor: l6's compression is TextFile's"
