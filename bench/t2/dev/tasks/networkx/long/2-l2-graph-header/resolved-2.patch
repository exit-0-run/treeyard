+def parse_graph_header(lines, comments="#"):
+    """The graph header of the lines of a file in the edge list, adjacency
+    list or multiline adjacency list format.
+
+    Parameters
+    ----------
+    lines : iterable of str
+       The lines of the file.
+    comments : str, optional (default="#")
+       The comment string of the file.
+
+    Returns
+    -------
+    dict or None
+       ``{"directed": bool, "multigraph": bool, "name": str or None}`` when a
+       header line (as written with ``header=True``) comes before the first
+       data line, else None. Reading stops at the first data line.
+
+    Examples
+    --------
+    >>> nx.parse_graph_header(
+    ...     ["# networkx-graph: directed=True multigraph=False", "1 2"]
+    ... )
+    {'directed': True, 'multigraph': False, 'name': None}
+
+    See Also
+    --------
+    read_graph_header
+    """
+    for line in lines:
+        info = parse_header(line, comments)
+        if info is not None:
+            return info
+        text = line.strip()
+        if text and not (comments is not None and text.startswith(comments)):
+            return None
+    return None
+
+
+@open_file(0, mode="rb")
+def read_graph_header(path, comments="#", encoding="utf-8"):
+    """The graph header of a file in the edge list, adjacency list or
+    multiline adjacency list format, without reading the rest of it.
+
+    Parameters
+    ----------
+    path : file or string
+       File or filename to read. Filenames ending in .gz or .bz2 are
+       uncompressed.
+    comments : str, optional (default="#")
+       The comment string of the file.
+    encoding : str, optional (default="utf-8")
+       The text encoding of the file.
+
+    Returns
+    -------
+    dict or None
+       What :func:`parse_graph_header` returns for the lines of the file.
+
+    See Also
+    --------
+    parse_graph_header
+    """
+    lines = (line if isinstance(line, str) else line.decode(encoding) for line in path)
+    return parse_graph_header(lines, comments)
