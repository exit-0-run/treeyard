diff --git a/networkx/readwrite/_compression.py b/networkx/readwrite/_compression.py
new file mode 100644
--- /dev/null
+++ b/networkx/readwrite/_compression.py
@@ -0,0 +1,57 @@
+"""Compressed files for the line formats (edge list, adjacency lists, Pajek,
+LEDA).
+
+The readers recognise a gzip, bz2 or xz file by its first bytes, whatever its
+name; the writers compress with ``compression="gzip"``, ``"bz2"`` or ``"xz"``.
+"""
+
+import bz2
+import gzip
+import io
+import lzma
+
+__all__ = []
+
+# The first bytes of each kind of compressed file.
+MAGIC = ((b"\x1f\x8b", gzip), (b"BZh", bz2), (b"\xfd7zXZ\x00", lzma))
+COMPRESSIONS = {"gzip": gzip.GzipFile, "bz2": bz2.BZ2File, "xz": lzma.LZMAFile}
+ENDINGS = (".gz", ".gzip", ".bz2", ".xz")
+
+
+def uncompressed(f):
+    """The open binary file `f`, uncompressed when its content is gzip, bz2 or
+    xz data (several compressions in a row are all undone). A file of text
+    lines (``str``) is returned as it is."""
+    data = f.read()
+    if isinstance(data, str):
+        return io.StringIO(data)
+    while True:
+        for magic, module in MAGIC:
+            if data.startswith(magic):
+                data = module.decompress(data)
+                break
+        else:
+            return io.BytesIO(data)
+
+
+def compressing(f, compression):
+    """``(writer, finish)``: the file to write to and the function to call when
+    all is written. With `compression` None they are `f` and a no-op; else a
+    writer that compresses into `f` (which stays open)."""
+    if compression is None:
+        return f, lambda: None
+    if compression not in COMPRESSIONS:
+        raise ValueError(
+            f"compression must be None, 'gzip', 'bz2' or 'xz', not {compression!r}"
+        )
+    name = getattr(f, "name", None)
+    if isinstance(name, str) and name.endswith(ENDINGS):
+        raise ValueError(
+            f"compression={compression!r} with the file name {name!r}: its ending already compresses"
+        )
+    writer = (
+        COMPRESSIONS[compression](f, mode="wb")
+        if compression != "gzip"
+        else gzip.GzipFile(fileobj=f, mode="wb")
+    )
+    return writer, writer.close
diff --git a/networkx/readwrite/_encoding.py b/networkx/readwrite/_encoding.py
new file mode 100644
--- /dev/null
+++ b/networkx/readwrite/_encoding.py
@@ -0,0 +1,63 @@
+"""Byte order marks and encoding detection for the line formats."""
+
+import codecs
+import re
+
+__all__ = []
+
+_BOMS = (
+    (codecs.BOM_UTF8, "utf-8"),
+    (codecs.BOM_UTF16_LE, "utf-16-le"),
+    (codecs.BOM_UTF16_BE, "utf-16-be"),
+)
+
+
+def _canonical(encoding):
+    return codecs.lookup(encoding).name
+
+
+def decoded_lines(f, encoding="utf-8"):
+    """The lines of the open file `f` as text, line ends kept.
+
+    A UTF-8 byte order mark at the start is skipped when the encoding is
+    UTF-8. With ``encoding=None`` the encoding comes from the byte order mark
+    (UTF-8, UTF-16 LE or UTF-16 BE), UTF-8 when there is none.
+    """
+    if encoding is None:
+        data = f.read()
+        if isinstance(data, str):
+            return iter(_lines(data.removeprefix("﻿")))
+        encoding = "utf-8"
+        for bom, name in _BOMS:
+            if data.startswith(bom):
+                data, encoding = data[len(bom) :], name
+                break
+        return iter(_lines(data.decode(encoding)))
+    utf8 = _canonical(encoding) == "utf-8"
+
+    def gen():
+        first = True
+        for line in f:
+            if not isinstance(line, str):
+                line = line.decode(encoding)
+            if first and utf8:
+                line = line.removeprefix("﻿")
+            first = False
+            yield line
+
+    return gen()
+
+
+def _lines(text):
+    return re.findall(r"[^\n]*\n|[^\n]+\Z", text)
+
+
+def bom_bytes(encoding):
+    """The byte order mark of `encoding` for ``bom=True``."""
+    name = _canonical(encoding)
+    for bom, bom_name in _BOMS:
+        if name == bom_name:
+            return bom
+    raise ValueError(
+        f"bom=True needs the encoding utf-8, utf-16-le or utf-16-be, not {encoding!r}"
+    )
