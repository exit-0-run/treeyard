+++ b/networkx/readwrite/_floats.py
@@ -0,0 +1,25 @@
+"""The text of edge data for the line formats, with ``float_format``."""
+
+__all__ = []
+
+
+def value_text(value, float_format=None):
+    """``str(value)``, or ``format(value, float_format)`` for a float when
+    `float_format` is given."""
+    if float_format is not None and isinstance(value, float):
+        return format(value, float_format)
+    return str(value)
+
+
+def data_text(data, float_format=None):
+    """The text of an edge data dict: ``str(dict(data))``; with
+    `float_format`, float values are written with it and keys and other values
+    with ``repr`` as ``str`` of a dict does."""
+    data = dict(data)
+    if float_format is None:
+        return str(data)
+    items = []
+    for key, value in data.items():
+        text = format(value, float_format) if isinstance(value, float) else repr(value)
+        items.append(f"{key!r}: {text}")
+    return "{" + ", ".join(items) + "}"
diff --git a/networkx/readwrite/_header.py b/networkx/readwrite/_header.py
new file mode 100644
--- /dev/null
+++ b/networkx/readwrite/_header.py
@@ -0,0 +1,78 @@
+"""The graph header line of the line formats (edge list, adjacency lists).
+
+``write_*(..., header=True)`` writes as the first line::
+
+    # networkx-graph: directed=True multigraph=False name="roads"
+
+(``name=`` only for a graph with a name, as a JSON string),
+
+and the ``parse_*``/``read_*`` functions build a graph of that type when
+such a line comes before the first data line and ``create_using`` is None.
+"""
+
+import json
+
+import networkx as nx
+
+__all__ = []
+
+_CLASSES = {
+    (False, False): nx.Graph,
+    (True, False): nx.DiGraph,
+    (False, True): nx.MultiGraph,
+    (True, True): nx.MultiDiGraph,
+}
+
+
+def header_line(G, comments="#"):
+    """The header line of `G`, without its line end."""
+    line = f"{comments} networkx-graph: directed={G.is_directed()} multigraph={G.is_multigraph()}"
+    if G.name:
+        line += f" name={json.dumps(str(G.name))}"
+    return line
+
+
+def parse_header(line, comments="#"):
+    """``{"directed": bool, "multigraph": bool, "name": str or None}`` of the
+    header `line`, or None when `line` is not a header line."""
+    if comments is None:
+        return None
+    text = line.rstrip("\r\n").strip()
+    if not text.startswith(comments):
+        return None
+    words = text[len(comments) :].split(None, 3)
+    if len(words) < 3 or words[0] != "networkx-graph:":
+        return None
+    flags = {"True": True, "False": False}
+    if not (words[1].startswith("directed=") and words[2].startswith("multigraph=")):
+        return None
+    directed = flags.get(words[1][len("directed=") :])
+    multigraph = flags.get(words[2][len("multigraph=") :])
+    if directed is None or multigraph is None:
+        return None
+    name = None
+    if len(words) == 4:
+        if not words[3].startswith("name="):
+            return None
+        try:
+            name = json.loads(words[3][len("name=") :])
+        except ValueError:
+            return None
+        if not isinstance(name, str):
+            return None
+    return {"directed": directed, "multigraph": multigraph, "name": name}
+
+
+def header_name(line, comments="#"):
+    """The graph name of the header `line` (None without one)."""
+    info = parse_header(line, comments)
+    return info["name"] if info else None
+
+
+def graph_class(line, comments="#"):
+    """The graph class that the header `line` names, or None when `line` is
+    not a header line."""
+    info = parse_header(line, comments)
+    if info is None:
+        return None
+    return _CLASSES[info["directed"], info["multigraph"]]
diff --git a/networkx/readwrite/_lineparser.py b/networkx/readwrite/_lineparser.py
new file mode 100644
--- /dev/null
+++ b/networkx/readwrite/_lineparser.py
@@ -0,0 +1,294 @@
+"""The parser of the line formats: edge list, adjacency list and multiline
+adjacency list.
+
+:func:`~networkx.readwrite.edgelist.parse_edgelist`,
+:func:`~networkx.readwrite.adjlist.parse_adjlist` and
+:func:`~networkx.readwrite.multiline_adjlist.parse_multiline_adjlist` are
+``LineParser(comments, delimiter, nodetype).parse_*(lines, ...)``. The steps
+that the three formats share (removing a comment, splitting a line,
+converting a node name) are methods, so a subclass can change one of them
+for all three formats.
+"""
+
+import networkx as nx
+from networkx.exception import LineParseError
+from networkx.readwrite._header import graph_class, header_name
+from networkx.readwrite._quote import split_names, strip_comment
+
+
+class _Through:
+    """The ``nodetype`` seen by the parse methods: a call goes through
+    :meth:`LineParser.node`, and a message shows the ``nodetype`` given."""
+
+    def __init__(self, call, shown):
+        self.call = call
+        self.shown = shown
+
+    def __call__(self, text):
+        return self.call(text)
+
+    def __str__(self):
+        return str(self.shown)
+
+    def __repr__(self):
+        return repr(self.shown)
+
+
+__all__ = ["LineParser"]
+
+
+class LineParser:
+    """Reads graphs from lines in the edge list, adjacency list and multiline
+    adjacency list formats.
+
+    Parameters
+    ----------
+    comments : str or None, optional (default="#")
+        The text that starts a comment; None for no comments.
+    delimiter : str or None, optional (default=None)
+        The text between the tokens of a line; None for runs of whitespace.
+    nodetype : callable or None, optional (default=None)
+        Converts the text of a node name to the node.
+
+    .. versionadded:: 3.8
+    """
+
+    def __init__(self, comments="#", delimiter=None, nodetype=None):
+        self.comments = comments
+        self.delimiter = delimiter
+        self.nodetype = nodetype
+
+    def strip(self, line):
+        """`line` without its comment: the text from the first `comments`
+        string that is not inside a quoted name."""
+        return strip_comment(line, self.comments, self.delimiter)
+
+    def split(self, line, names=None):
+        """The tokens of a line whose comment is removed: the line end goes
+        and the rest is split at the delimiter. The first `names` tokens (all
+        when None) are node names and may be quoted."""
+        return split_names(line.rstrip("\r\n"), self.delimiter, names=names)
+
+    def _strip_comment(self, line, comments, delimiter):
+        return self.strip(line)
+
+    def _split_names(self, text, delimiter, names=None):
+        return self.split(text, names=names)
+
+    def node(self, text):
+        """The node of the name `text`: ``nodetype(text)``, or `text` when there
+        is no `nodetype`. An error of `nodetype` propagates; the ``parse_*``
+        methods turn it into the error they raise."""
+        if self.nodetype is None:
+            return text
+        return self.nodetype(text)
+
+    def parse_edgelist(self, lines, create_using=None, data=True):
+        """The graph of the edge list `lines`: what
+        :func:`~networkx.readwrite.edgelist.parse_edgelist` returns."""
+        comments, delimiter = self.comments, self.delimiter
+        nodetype = None if self.nodetype is None else _Through(self.node, self.nodetype)
+        strip_comment, split_names = self._strip_comment, self._split_names
+        from ast import literal_eval
+
+        G = nx.empty_graph(0, create_using)
+        seen_data = create_using is not None
+        for lineno, line in enumerate(lines, 1):
+            if not seen_data:
+                cls = graph_class(line, comments)
+                if cls is not None:
+                    G = nx.empty_graph(0, cls)
+                    if header_name(line, comments):
+                        G.graph["name"] = header_name(line, comments)
+                    continue
+            text = line
+            if comments is not None:
+                line = strip_comment(line, comments, delimiter)
+                if not line:
+                    continue
+            # split line, should have 2 or more; the two node names may be quoted
+            # with data keys every value may be quoted too; else the data is text
+            names = None if data not in (True, False) else 2
+            s = split_names(line.rstrip("\r\n"), delimiter, names=names)
+            if len(s) < 2:
+                continue
+            seen_data = True
+            u = s.pop(0)
+            v = s.pop(0)
+            d = s
+            if nodetype is not None:
+                try:
+                    u = nodetype(u)
+                    v = nodetype(v)
+                except Exception as err:
+                    raise LineParseError(
+                        f"Failed to convert nodes {u},{v} to type {nodetype}.", lineno, text
+                    ) from err
+
+            if len(d) == 0 or data is False:
+                # no data or data type specified
+                edgedata = {}
+            elif data is True:
+                # no edge types specified
+                try:  # try to evaluate as dictionary
+                    if delimiter == ",":
+                        edgedata_str = ",".join(d)
+                    else:
+                        edgedata_str = " ".join(d)
+                    edgedata = dict(literal_eval(edgedata_str.strip()))
+                except Exception as err:
+                    raise LineParseError(
+                        f"Failed to convert edge data ({d}) to dictionary.", lineno, text
+                    ) from err
+            else:
+                # convert edge data to dictionary with specified keys and type
+                if len(d) != len(data):
+                    raise IndexError(
+                        f"Edge data {d} and data_keys {data} are not the same length"
+                    )
+                edgedata = {}
+                for (edge_key, edge_type), edge_value in zip(data, d):
+                    try:
+                        edge_value = edge_type(edge_value)
+                    except Exception as err:
+                        raise LineParseError(
+                            f"Failed to convert {edge_key} data {edge_value} "
+                            f"to type {edge_type}.",
+                            lineno,
+                            text,
+                        ) from err
+                    edgedata.update({edge_key: edge_value})
+            G.add_edge(u, v, **edgedata)
+        return G
+
+    def parse_adjlist(self, lines, create_using=None):
+        """The graph of the adjacency list `lines`: what
+        :func:`~networkx.readwrite.adjlist.parse_adjlist` returns."""
+        comments, delimiter = self.comments, self.delimiter
+        nodetype = None if self.nodetype is None else _Through(self.node, self.nodetype)
+        strip_comment, split_names = self._strip_comment, self._split_names
+        G = nx.empty_graph(0, create_using)
+        seen_data = create_using is not None
+        for lineno, line in enumerate(lines, 1):
+            text = line
+            if not seen_data:
+                cls = graph_class(line, comments)
+                if cls is not None:
+                    G = nx.empty_graph(0, cls)
+                    if header_name(line, comments):
+                        G.graph["name"] = header_name(line, comments)
+                    continue
+            line = strip_comment(line, comments, delimiter)
+            if not len(line):
+                continue
+            seen_data = True
+            vlist = split_names(line.rstrip("\r\n"), delimiter)
+            u = vlist.pop(0)
+            # convert types
+            if nodetype is not None:
+                try:
+                    u = nodetype(u)
+                except BaseException as err:
+                    raise LineParseError(
+                        f"Failed to convert node ({u}) to type {nodetype}", lineno, text
+                    ) from err
+            G.add_node(u)
+            if nodetype is not None:
+                try:
+                    vlist = list(map(nodetype, vlist))
+                except BaseException as err:
+                    raise LineParseError(
+                        f"Failed to convert nodes ({','.join(vlist)}) to type {nodetype}",
+                        lineno,
+                        text,
+                    ) from err
+            G.add_edges_from([(u, v) for v in vlist])
+        return G
+
+    def parse_multiline_adjlist(self, lines, create_using=None, edgetype=None):
+        """The graph of the multiline adjacency list `lines`:
+        what
+        :func:`~networkx.readwrite.multiline_adjlist.parse_multiline_adjlist`
+        returns."""
+        comments, delimiter = self.comments, self.delimiter
+        nodetype = None if self.nodetype is None else _Through(self.node, self.nodetype)
+        strip_comment, split_names = self._strip_comment, self._split_names
+        from ast import literal_eval
+
+        G = nx.empty_graph(0, create_using)
+        seen_data = create_using is not None
+        lines = iter(lines)
+        lineno = 0
+        for line in lines:
+            lineno += 1
+            text = line
+            node_lineno = lineno
+            if not seen_data:
+                cls = graph_class(line, comments)
+                if cls is not None:
+                    G = nx.empty_graph(0, cls)
+                    if header_name(line, comments):
+                        G.graph["name"] = header_name(line, comments)
+                    continue
+            line = strip_comment(line, comments, delimiter)
+            if not line:
+                continue
+            seen_data = True
+            try:
+                (u, deg) = split_names(line.rstrip("\r\n"), delimiter, names=1)
+                deg = int(deg)
+            except BaseException as err:
+                raise LineParseError(
+                    f"Failed to read node and degree on line ({line})", lineno, text
+                ) from err
+            if nodetype is not None:
+                try:
+                    u = nodetype(u)
+                except BaseException as err:
+                    raise LineParseError(
+                        f"Failed to convert node ({u}) to type {nodetype}", lineno, text
+                    ) from err
+            G.add_node(u)
+            node_text = text
+            for i in range(deg):
+                while True:
+                    try:
+                        line = next(lines)
+                    except StopIteration as err:
+                        msg = f"Failed to find neighbor for node ({u})"
+                        raise LineParseError(msg, node_lineno, node_text) from err
+                    lineno += 1
+                    text = line
+                    line = strip_comment(line, comments, delimiter)
+                    if line:
+                        break
+                vlist = split_names(line.rstrip("\r\n"), delimiter, names=1)
+                numb = len(vlist)
+                if numb < 1:
+                    continue  # isolated node
+                v = vlist.pop(0)
+                data = "".join(vlist)
+                if nodetype is not None:
+                    try:
+                        v = nodetype(v)
+                    except BaseException as err:
+                        raise LineParseError(
+                            f"Failed to convert node ({v}) to type {nodetype}", lineno, text
+                        ) from err
+                if edgetype is not None:
+                    try:
+                        edgedata = {"weight": edgetype(data)}
+                    except BaseException as err:
+                        raise LineParseError(
+                            f"Failed to convert edge data ({data}) to type {edgetype}",
+                            lineno,
+                            text,
+                        ) from err
+                else:
+                    try:  # try to evaluate
+                        edgedata = literal_eval(data)
+                    except:
+                        edgedata = {}
+                G.add_edge(u, v, **edgedata)
+
+        return G
diff --git a/networkx/readwrite/_newlines.py b/networkx/readwrite/_newlines.py
new file mode 100644
--- /dev/null
+++ b/networkx/readwrite/_newlines.py
@@ -0,0 +1,31 @@
+"""Line ends for the line formats: ``\\n``, ``\\r\\n`` or ``\\r``."""
+
+import re
+
+__all__ = []
+
+NEWLINES = ("\n", "\r\n", "\r")
+
+_END = re.compile(r"[^\r\n]*(?:\r\n|\r|\n)|[^\r\n]+\Z")
+
+
+def split_line_ends(lines):
+    """The lines of `lines` (text pieces as a file yields them), split again at
+    every ``\\r\\n``, ``\\r`` or ``\\n``, each with its line end."""
+    rest = ""
+    for piece in lines:
+        text = rest + piece
+        rest = ""
+        parts = _END.findall(text)
+        if parts and parts[-1].endswith("\r") and text.endswith("\r"):
+            # a "\r" at the end of a piece may be the first half of "\r\n"
+            rest = parts.pop()
+        yield from parts
+    if rest:
+        yield rest
+
+
+def check_newline(newline):
+    """Raises ValueError unless `newline` is ``"\\n"``, ``"\\r\\n"`` or ``"\\r"``."""
+    if newline not in NEWLINES:
+        raise ValueError(f'newline must be "\\n", "\\r\\n" or "\\r", not {newline!r}')
diff --git a/networkx/readwrite/_quote.py b/networkx/readwrite/_quote.py
new file mode 100644
--- /dev/null
+++ b/networkx/readwrite/_quote.py
@@ -0,0 +1,139 @@
+"""Quoted node names for the line formats (edge list, adjacency lists).
+
+A node name that cannot be written as a bare token is written in double
+quotes. Inside the quotes a backslash is written as ``\\\\``, a double quote
+as ``\\"``, a line feed as ``\\n`` and a carriage return as ``\\r``.
+"""
+
+__all__ = []
+
+# The escapes inside a quoted name: a line break would end the line.
+_ESCAPES = {"n": "\n", "r": "\r"}
+
+
+def needs_quotes(name, delimiter=" "):
+    """True when the text `name` cannot be written as a bare token: it is
+    empty, or holds whitespace, the delimiter, ``#``, ``"`` or ``\\``."""
+    if name == "":
+        return True
+    if any(c.isspace() for c in name):
