+"""The bytes of the line formats: decoding the lines of a file and encoding
+the lines written to one.
+
+The ``read_*`` functions of the edge list, adjacency list and multiline
+adjacency list read every line through :meth:`TextFile.read_lines`, and the
+``write_*`` functions write every line (comment and header lines included)
+through :meth:`TextFile.write_lines`.
+"""
+
+from networkx.readwrite._encoding import bom_bytes, decoded_lines
+from networkx.readwrite._newlines import check_newline, split_line_ends
+
+__all__ = ["TextFile"]
+
+
+class TextFile:
+    """How lines are read from and written to a file of a line format.
+
+    Parameters
+    ----------
+    encoding : str or None, optional (default="utf-8")
+        The text encoding of the file.
+    bom : bool, optional (default=False)
+        Write the byte order mark of `encoding` first.
+    newline : str, optional (default="\\n")
+        The line end written after each line.
+
+    .. versionadded:: 3.8
+    """
+
+    def __init__(self, encoding="utf-8", bom=False, newline="\n"):
+        self.encoding = encoding
+        self.bom = bom
+        self.newline = newline
+
+    def read_lines(self, f):
+        """The lines of the open file `f` as text, each with its line end."""
+        encoding = self.encoding
+        return split_line_ends(decoded_lines(f, self.encoding))
+
+    def write_lines(self, f, lines):
+        """Writes each of `lines` (text without line ends) to the binary file
+        `f`, followed by the line end."""
+        encoding = self.encoding
+        newline = self.newline
+        check_newline(newline)
+        if self.bom:
+            f.write(bom_bytes(encoding))
+        for line in lines:
+            line += newline
+            f.write(line.encode(encoding))
