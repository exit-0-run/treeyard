+class TooManyAttempts(ClickException):
+    """Raised by :func:`click.prompt` and :func:`click.confirm` when the
+    user gave ``max_attempts`` invalid answers in a row. Inside a command
+    it ends the program with exit code 1 and the message
+    ``Error: Gave up after 3 invalid answers.``
+
+    :param attempts: the number of invalid answers.
+    :param last_error: the error message of the last invalid answer.
+
+    .. versionadded:: 8.6
+    """
+
+    exit_code: t.ClassVar[int] = 1
+
+    def __init__(self, attempts: int, last_error: str | None = None) -> None:
+        message = ngettext(
+            "Gave up after {attempts} invalid answer.",
+            "Gave up after {attempts} invalid answers.",
+            attempts,
