+class _Attempts:
+    """Counts the invalid answers of one prompt and writes their error
+    lines; raises :exc:`TooManyAttempts` after the last one allowed.
+    """
+
+    def __init__(self, max_attempts: int | None, err: bool) -> None:
+        if max_attempts is not None and max_attempts < 1:
+            raise ValueError("'max_attempts' must be at least 1.")
+
+        self.max_attempts = max_attempts
+        self.err = err
+        self.count = 0
+
+    def failed(self, message: str) -> None:
+        self.count += 1
+        line = _("Error: {message}").format(message=message)
+
+        if self.max_attempts is None:
+            echo(line, err=self.err)
+            return
+
+        left = self.max_attempts - self.count
+
+        if left <= 0:
+            echo(line, err=self.err)
+            raise TooManyAttempts(self.count, message)
+
+        hint = ngettext(
+            "{left} attempt left", "{left} attempts left", left
+        ).format(left=left)
+        echo(f"{line} ({hint})", err=self.err)
