+class NuComplete(ShellComplete):
+    """Shell completion for Nushell, as an external completer.
+
+    The script defines a command that the external completer of the
+    user's ``config.nu`` calls with the words of the command line. The
+    answer is a JSON list of records with a ``value`` and, for items with
+    a help text, a ``description``. When an item asks for file or
+    directory completion the answer is ``null``, so that Nushell
+    completes paths itself.
+
+    .. versionadded:: 8.6
+    """
+
+    name: t.ClassVar[str] = "nu"
+    source_template: t.ClassVar[str] = _SOURCE_NU
+
+    @staticmethod
+    def _check_version() -> None:
+        """Warn when ``nu`` is older than 0.90: the script uses the record
+        form of ``with-env`` that older versions do not have. Nothing is
+        said when ``nu`` is not on the ``PATH`` (the script may be made
+        for another machine).
+        """
+        import shutil
+        import subprocess
+
+        nu_exe = shutil.which("nu")
+
+        if nu_exe is None:
+            return
+
+        output = subprocess.run([nu_exe, "--version"], stdout=subprocess.PIPE)
+        match = re.search(r"^(\d+)\.(\d+)", output.stdout.decode())
+
+        if match is None:
+            echo(
+                _("Couldn't detect the Nushell version, completion may not work."),
+                err=True,
+            )
+        elif (int(match.group(1)), int(match.group(2))) < (0, 90):
+            echo(
+                _(
+                    "Shell completion is not supported for Nushell"
+                    " versions older than 0.90."
+                ),
+                err=True,
+            )
+
+    def source(self) -> str:
+        self._check_version()
+        return super().source()
+
+    def get_completion_args(self) -> tuple[list[str], str]:
+        # One word per line; the first is the program, the last the word
+        # being completed (empty after a space).
+        words = os.environ["COMP_WORDS"].split("\n")
+        args = words[1:-1]
+        incomplete = words[-1] if len(words) > 1 else ""
+        return args, incomplete
+
+    def format_completion(self, item: CompletionItem[t.Any]) -> str:
+        record: dict[str, str] = {"value": str(item.value)}
+
+        if item.help:
+            record["description"] = " ".join(item.help.split())
+
+        return json.dumps(record)
+
+    def complete(self) -> str:
+        args, incomplete = self.get_completion_args()
+        completions = self.get_completions(args, incomplete)
+
+        # Nushell completes paths itself when the completer returns null.
+        if any(item.type in ("file", "dir") for item in completions):
+            return "null"
+
+        out = [self.format_completion(item) for item in completions]
+        return f"[{', '.join(out)}]"
+
+
 _available_shells: t.Final[dict[str, type[ShellComplete]]] = {
