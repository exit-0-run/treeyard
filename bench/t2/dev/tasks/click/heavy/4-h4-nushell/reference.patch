+# Nushell asks an external completer with the words of the command line
+# (its "spans", the last one being the word under the cursor) and expects a
+# list of records back, or null to fall back to its own file completion.
+# The spans are passed one per line in COMP_WORDS.
+_SOURCE_NU = """\
+# Nushell completion for %(prog_name)s.
+#
+# Call this command from the external completer in your config.nu:
+#
+#     $env.config.completions.external.enable = true
+#     $env.config.completions.external.completer = {|spans|
+#         match $spans.0 {
+#             %(prog_name)s => { %(complete_func)s $spans }
+#             _ => null
+#         }
+#     }
+def "%(complete_func)s" [spans: list<string>] {
+    with-env {
+        %(complete_var)s: "nu_complete"
+        COMP_WORDS: ($spans | str join (char nl))
+    } {
+        ^%(prog_name)s | from json
+    }
+}
+"""
+
