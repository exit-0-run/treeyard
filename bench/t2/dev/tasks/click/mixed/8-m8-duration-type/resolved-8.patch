+class Duration(ParamType[timedelta]):
+    """Converts a duration to a :class:`datetime.timedelta`: a number of
+    seconds (``90``, ``1.5``) or parts with the units ``d``, ``h``, ``m``
+    and ``s`` in that order (``1h30m``, ``2d``).
+    """
+
+    name = "duration"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        import re
+
+        if isinstance(value, timedelta):
+            return value
+
+        text = str(value).strip().lower()
+        if re.fullmatch(r"\d+(\.\d+)?", text):
+            return timedelta(seconds=float(text))
+
+        match = re.fullmatch(r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text)
+        if not text or match is None:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value), param, ctx
+            )
+
+        days, hours, minutes, seconds = (int(g or 0) for g in match.groups())
+        return timedelta(days=days, hours=hours, minutes=minutes, seconds=seconds)
+
+    def __repr__(self) -> str:
+        return "Duration"
 
 
