+    def check(self, exit_code: int = 0) -> Result:
+        """Return this result when its exit code is ``exit_code``, else raise
+        :exc:`AssertionError` with the exit code, the exception and the end of
+        the output.
+        """
+        if self.exit_code == exit_code:
+            return self
+        lines = [f"exit code {self.exit_code}, expected {exit_code}"]
+        if self.exception is not None and not isinstance(self.exception, SystemExit):
+            lines.append(f"exception: {self.exception!r}")
+        lines.append("output:")
+        lines.extend(self.output.splitlines()[-20:])
+        raise AssertionError("\n".join(lines))
 
