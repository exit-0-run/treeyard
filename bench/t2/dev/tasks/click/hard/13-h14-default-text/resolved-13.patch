@@ -0,0 +1,130 @@
+"""The text of a default value: what the help bracket of an option and the
+brackets of a prompt show for it.
+
+:meth:`Option.get_help_extra <click.Option.get_help_extra>` takes the
+``default`` item from :func:`default_help_text`, and :func:`click.prompt`
+shows :func:`default_prompt_text` between the brackets of its default, so
+both rules live here.
+"""
+
+from __future__ import annotations
+
+import enum
+import inspect
+import io
+import typing as t
+from gettext import gettext as _
+
+from ._utils import UNSET
+from .parser import _split_opt
+from .types import ParamType
+from .utils import _LazyFile
+
+if t.TYPE_CHECKING:
+    from .core import Context
+    from .core import Option
+
+
+def default_help_text(option: Option, ctx: Context) -> str | None:
+    """The text of the ``default`` item of an option's help bracket (``2``
+    in ``[default: 2]``), or ``None`` when the help shows no default.
+
+    The default is shown when the option's ``show_default`` (or else the
+    context's) says so. A ``show_default`` string is shown in parentheses
+    instead of the value. The default of a hidden input shows as
+    ``(hidden)``, and a value as the type's
+    :meth:`~click.ParamType.format_value` text.
+
+    .. versionadded:: 8.6
+    """
+    # The rules read the option the way its own methods do.
+    self = option
+
+    # Temporarily enable resilient parsing to avoid type casting
+    # failing for the default. Might be possible to extend this to
+    # help formatting in general.
+    resilient = ctx.resilient_parsing
+    ctx.resilient_parsing = True
+
+    try:
+        default_value = self.get_default(ctx, call=False)
+    finally:
+        ctx.resilient_parsing = resilient
+
+    show_default = False
+    show_default_is_str = False
+
+    if self.show_default is not None:
+        if isinstance(self.show_default, str):
+            show_default_is_str = show_default = True
+        else:
+            show_default = self.show_default
+    elif ctx.show_default is not None:
+        show_default = ctx.show_default
+
+    if not show_default_is_str and not (
+        show_default and (default_value not in (None, UNSET))
+    ):
+        return None
+
+    if show_default_is_str:
+        default_string = f"({self.show_default})"
+    elif isinstance(default_value, (list, tuple)):
+        default_string = ", ".join(
+            str(self.type.format_value(d)) for d in default_value
+        )
+    elif isinstance(default_value, enum.Enum):
+        default_string = default_value.name
+    elif inspect.isfunction(default_value):
+        default_string = _("(dynamic)")
+    elif self.is_bool_flag and self.secondary_opts:
+        # For boolean flags that have distinct True/False opts,
+        # use the opt without prefix instead of the value.
+        default_string = _split_opt(
+            (self.opts if default_value else self.secondary_opts)[0]
+        )[1]
+    elif self.is_bool_flag and not self.secondary_opts and not default_value:
+        default_string = ""
+    elif isinstance(default_value, str) and default_value == "":
+        default_string = '""'
+    else:
+        default_string = str(self.type.format_value(default_value))
+
+    # The default of a hidden input is a secret: show that there is
+    # one, never its value. A ``show_default`` string is not the value.
+    if self.hide_input and not show_default_is_str and default_string:
+        default_string = _("(hidden)")
+
+    return default_string or None
+
+
+def default_prompt_text(default: t.Any, type: t.Any | None = None) -> str:
+    """The text that a prompt shows between the brackets for its default
+    (``alice`` in ``Name [alice]: ``): an enum member by its name, an open
+    file by its name, a value of a :class:`ParamType` as its
+    :meth:`~ParamType.format_value` text, ``str()`` of anything else.
+
+    :param default: the default of the prompt.
+    :param type: the ``type`` of the prompt, a :class:`ParamType` or
+        ``None``.
+
+    .. versionadded:: 8.6
+    """
+    return str(_prompt_default(default, type))
+
+
+def _prompt_default(default: t.Any, type: t.Any | None = None) -> t.Any:
+    """The rules of :func:`default_prompt_text`, before ``str()``."""
+    if isinstance(default, enum.Enum):
+        return default.name
+
+    if isinstance(default, (io.IOBase, _LazyFile)):
+        name = getattr(default, "name", None)
+
+        if name is not None:
+            return str(name)
+
+    if isinstance(type, ParamType):
+        return type.format_value(default)
+
+    return default
