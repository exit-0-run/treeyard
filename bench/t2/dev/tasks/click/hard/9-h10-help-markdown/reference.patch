+    def get_help_markdown(self, ctx: Context) -> str:
+        """The help page as Markdown: a ``# <command path>`` title, then
+        the sections of :meth:`get_help` written by a
+        :class:`MarkdownHelpFormatter`. Useful to generate reference docs.
+
+        .. code-block:: python
+
+            with click.Context(cli, info_name="cli") as ctx:
+                Path("docs/cli.md").write_text(cli.get_help_markdown(ctx))
+
+        .. versionadded:: 8.6
+        """
+        formatter = MarkdownHelpFormatter(
+            width=ctx.terminal_width, max_width=ctx.max_content_width
+        )
+        formatter.write_title(ctx.command_path)
+        self.format_help(ctx, formatter)
+        return formatter.getvalue()
