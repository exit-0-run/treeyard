{
  "set": "hard",
  "agents": 13,
  "mix": [
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude",
    "claude"
  ],
  "limits": {
    "max_turns": 300,
    "max_tokens": 20000000,
    "timeout_s": 3600,
    "claude_budget_usd": 8.0
  },
  "sequential": true,
  "tasks": [
    "h1-prompt-text",
    "h2-help-items",
    "h3-secrets",
    "h5-prompt-attempts",
    "h6-option-groups",
    "h7-byte-size",
    "h8-choice-menu",
    "h9-help-theme",
    "h10-help-markdown",
    "h11-prompter",
    "h12-option-prompt",
    "h13-help-formatter",
    "h14-default-text"
  ],
  "integration": [
    {
      "id": "i1-prompt-text-enum-names",
      "pair": [
        1,
        7
      ],
      "test": "tests/test_t2_i1_prompt_text_enum_names.py",
      "why": "trap: h1 keeps today's text, h8 changes it on purpose; PromptText.render() is what prompt shows"
    },
    {
      "id": "i2-hidden-default-item",
      "pair": [
        2,
        3
      ],
      "test": "tests/test_t2_i2_hidden_default_item.py",
      "why": "trap: h2 keeps the bracket as today, h3 hides defaults; the per-item method gives the item"
    },
    {
      "id": "i3-group-headings-themed",
      "pair": [
        5,
        8
      ],
      "test": "tests/test_t2_i3_group_headings_themed.py",
      "why": "interface: h6 writes group sections with formatter.section, h9 styles every heading"
    },
    {
      "id": "i4-markdown-hidden-default",
      "pair": [
        3,
        9
      ],
      "test": "tests/test_t2_i4_markdown_hidden_default.py",
      "why": "interface: h10 shows the bracket items, h3 hides the default in the bracket"
    },
    {
      "id": "i5-markdown-byte-size",
      "pair": [
        6,
        9
      ],
      "test": "tests/test_t2_i5_markdown_byte_size.py",
      "why": "interface: h10 shows the bracket items, h7 formats the default and range as sizes"
    },
    {
      "id": "i6-markdown-option-groups",
      "pair": [
        5,
        9
      ],
      "test": "tests/test_t2_i6_markdown_option_groups.py",
      "why": "h10 renders every section of --help through the formatter, h6 adds group sections and a write_dl keyword"
    },
    {
      "id": "i7-prompt-text-byte-size",
      "pair": [
        1,
        6
      ],
      "test": "tests/test_t2_i7_prompt_text_byte_size.py",
      "why": "refactor: h7's formatted prompt default must live in PromptText.default_part"
    },
    {
      "id": "i8-markdown-with-a-theme",
      "pair": [
        8,
        9
      ],
      "test": "tests/test_t2_i8_markdown_with_a_theme.py",
      "why": "h9 styles the help bracket in core, h10 removes every style code"
    },
    {
      "id": "i9-markdown-custom-item",
      "pair": [
        2,
        9
      ],
      "test": "tests/test_t2_i9_markdown_custom_item.py",
      "why": "refactor x consumer: an item added through h2's help_extra_keys shows in h10's details"
    },
    {
      "id": "i10-prompter-secret",
      "pair": [
        10,
        3
      ],
      "test": "tests/test_t2_i10_prompter_secret.py",
      "why": "refactor: h3's hidden input for a Secret type must live in Prompter.ask"
    },
    {
      "id": "i11-prompter-attempts",
      "pair": [
        10,
        4
      ],
      "test": "tests/test_t2_i11_prompter_attempts.py",
      "why": "refactor: h5's max_attempts must be a parameter of Prompter and Prompter.confirm and work in their loops"
    },
    {
      "id": "i12-prompter-choice-menu",
      "pair": [
        10,
        7
      ],
      "test": "tests/test_t2_i12_prompter_choice_menu.py",
      "why": "refactor: h8's choice_menu must be a parameter of Prompter and work in Prompter.ask"
    },
    {
      "id": "i13-option-prompt-attempts",
      "pair": [
        11,
        4
      ],
      "test": "tests/test_t2_i13_option_prompt_attempts.py",
      "why": "refactor: h5's prompt_attempts must reach OptionPrompt.prompt_kwargs and confirm_kwargs"
    },
    {
      "id": "i14-option-prompt-menu",
      "pair": [
        11,
        7
      ],
      "test": "tests/test_t2_i14_option_prompt_menu.py",
      "why": "refactor: h8's prompt_menu must reach OptionPrompt.prompt_kwargs"
    },
    {
      "id": "i15-option-prompt-secret",
      "pair": [
        11,
        3
      ],
      "test": "tests/test_t2_i15_option_prompt_secret.py",
      "why": "refactor x feature: the prompt of a Secret option hides its input in OptionPrompt.prompt_kwargs"
    },
    {
      "id": "i16-help-formatter-groups",
      "pair": [
        12,
        5
      ],
      "test": "tests/test_t2_i16_help_formatter_groups.py",
      "why": "refactor: h6's write_dl(first_col_width=) must be in the class of click._help_formatter"
    },
    {
      "id": "i17-help-formatter-theme",
      "pair": [
        12,
        8
      ],
      "test": "tests/test_t2_i17_help_formatter_theme.py",
      "why": "refactor: h9's theme must be in the class of click._help_formatter"
    },
    {
      "id": "i18-help-formatter-markdown",
      "pair": [
        12,
        9
      ],
      "test": "tests/test_t2_i18_help_formatter_markdown.py",
      "why": "refactor: h10's MarkdownHelpFormatter must subclass the class of click._help_formatter"
    },
    {
      "id": "i19-default-text-hidden",
      "pair": [
        13,
        3
      ],
      "test": "tests/test_t2_i19_default_text_hidden.py",
      "why": "refactor: h3's (hidden) default must come from default_help_text"
    },
    {
      "id": "i20-default-text-byte-size",
      "pair": [
        13,
        6
      ],
      "test": "tests/test_t2_i20_default_text_byte_size.py",
      "why": "refactor: h7's sizes must come from default_help_text and default_prompt_text"
    },
    {
      "id": "i21-default-text-enum",
      "pair": [
        13,
        7
      ],
      "test": "tests/test_t2_i21_default_text_enum.py",
      "why": "refactor: h8's enum names in prompts must come from default_prompt_text"
    }
  ]
}
