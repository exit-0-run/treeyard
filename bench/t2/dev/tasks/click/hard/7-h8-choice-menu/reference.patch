+def _menu_value_proc(
+    type: Choice[t.Any], value_proc: t.Callable[[str], t.Any]
+) -> t.Callable[[str], t.Any]:
+    """Wraps the conversion of a menu prompt. An answer that is one of the
+    choices is that choice (so choices that are numbers still work);
+    otherwise the number of a choice selects it. Any other number is not
+    on the menu.
+    """
+
+    def convert(value: str) -> t.Any:
+        if not isinstance(value, str):
+            return value_proc(value)
+
+        try:
+            return value_proc(value)
+        except UsageError:
+            choice = type.choice_from_number(value)
+
+            if choice is not None:
+                return value_proc(choice)
+
+            if value.strip().isdigit():
+                raise BadParameter(
+                    _("{number} is not a number of the menu (1-{count}).").format(
+                        number=value.strip(), count=len(type.choices)
+                    )
+                ) from None
+
+            raise
+
+    return convert
 
 
