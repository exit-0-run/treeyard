+
+    def choice_from_number(self, answer: str) -> _ValueT_co | None:
+        """The choice that a numbered menu answer selects: ``"1"`` is the
+        first choice. ``None`` when the answer is not a number of the menu.
+
+        .. versionadded:: 8.6
+        """
+        text = answer.strip()
+
+        if not text.isdigit():
+            return None
+
+        number = int(text)
+
+        if not 1 <= number <= len(self.choices):
+            return None
+
+        return self.choices[number - 1]
 
