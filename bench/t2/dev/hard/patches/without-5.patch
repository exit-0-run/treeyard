+def _format_size(size: int) -> str:
+    """A number of bytes in the largest binary unit it reaches, with at
+    most one decimal: ``512 B``, ``1.5 KiB``, ``10 MiB``.
+    """
+    for unit, factor in _SIZE_NAMES:
+        if abs(size) >= factor:
+            text = f"{size / factor:.1f}"
+
+            if text.endswith(".0"):
+                text = text[:-2]
+
+            return f"{text} {unit}"
+
+    return f"{size} B"
+
