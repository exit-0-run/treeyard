+class ByteSize(_NumberRangeBase[t.Any, int], IntParamType):
+    """A size in bytes, converted to an ``int``. It accepts a plain number
+    of bytes (``"512"``) or a number with a unit, with or without a space
+    between, in any letter case: ``B``; ``K``/``KB``, ``M``/``MB``,
+    ``G``/``GB``, ``T``/``TB`` (powers of 1000); ``KiB``, ``MiB``,
+    ``GiB``, ``TiB`` (powers of 1024). A fraction is rounded down to whole
+    bytes: ``"1.5KiB"`` is ``1536``.
+
+    ``min`` and ``max`` bound the size like an :class:`IntRange`, and may
+    be given as sizes too (``max="1GiB"``). Help pages and prompts show
+    sizes in binary units: a default of ``10485760`` shows as ``10 MiB``,
+    the range as ``x<=1 GiB``.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "size"
+
+    def __init__(
+        self,
+        min: int | str | None = None,
+        max: int | str | None = None,
+        min_open: bool = False,
+        max_open: bool = False,
+        clamp: bool = False,
+    ) -> None:
+        super().__init__(
+            min=None if min is None else self._parse(min, None, None),
+            max=None if max is None else self._parse(max, None, None),
+            min_open=min_open,
+            max_open=max_open,
+            clamp=clamp,
+        )
+
+    def _parse(self, value: t.Any, param: Parameter | None, ctx: Context | None) -> int:
+        import re
+        from decimal import Decimal
+
+        if isinstance(value, int) and not isinstance(value, bool):
+            return value
+
+        match = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([a-zA-Z]*)\s*", str(value))
+        unit = match.group(2).lower() if match is not None else None
+
+        if match is None or unit not in _SIZE_UNITS:
+            self.fail(
+                _("{value!r} is not a valid size.").format(value=value), param, ctx
+            )
+
+        return int(Decimal(match.group(1)) * _SIZE_UNITS[unit])
+
+    def convert(self, value: t.Any, param: Parameter | None, ctx: Context | None) -> int:
+        return super().convert(self._parse(value, param, ctx), param, ctx)
+
+    def format_value(self, value: t.Any) -> str:
+        if isinstance(value, int) and not isinstance(value, bool):
+            return _format_size(value)
+
+        return str(value)
+
