+++ b/src/click/_option_prompt.py
@@ -0,0 +1,119 @@
+"""How an :class:`~click.Option` prompts for its value.
+
+:meth:`Option.consume_value <click.Option.consume_value>` asks through
+``option.prompt_class(option, ctx).ask()``; :class:`OptionPrompt` is the
+default class. Its steps are methods, so a subclass can change one of
+them (the default offered, the arguments of the prompt) and keep the
+others.
+"""
+
+from __future__ import annotations
+
+import typing as t
+
+from . import termui
+from ._utils import UNSET
+
+if t.TYPE_CHECKING:
+    from .core import Context
+    from .core import Option
+
+
+class OptionPrompt:
+    """The prompt of one option in one context.
+
+    :param option: the option that prompts.
+    :param ctx: the context of the command that is being invoked.
+
+    .. versionadded:: 8.6
+    """
+
+    def __init__(self, option: Option, ctx: Context) -> None:
+        self.option = option
+        self.ctx = ctx
+
+    def get_default(self) -> t.Any:
+        """The default that the prompt offers, computed before anything is
+        asked to lock in the value. For a boolean flag it is ``None`` when
+        there is no default (the user must answer), else a ``bool``.
+        """
+        default = self.option.get_default(self.ctx)
+
+        # A boolean flag can use a simplified [y/n] confirmation prompt.
+        if self.option.is_bool_flag:
+            # If we have no boolean default, we force the user to explicitly provide
+            # one.
+            if default in (UNSET, None):
+                return None
+            # Nothing prevent you to declare an option that is simultaneously:
+            # 1) auto-detected as a boolean flag,
+            # 2) allowed to prompt, and
+            # 3) still declare a non-boolean default.
+            # This forced casting into a boolean is necessary to align any non-boolean
+            # default to the prompt, which is going to be a [y/n]-style confirmation
+            # because the option is still a boolean flag. That way, instead of [y/n], we
+            # get [Y/n] or [y/N] depending on the truthy value of the default.
+            return bool(default)
+
+        return default
+
+    def confirm_kwargs(self, default: bool | None) -> dict[str, t.Any]:
+        """The keyword arguments of :func:`click.confirm` for a boolean
+        flag, given the default from :meth:`get_default`.
+        """
+        return _confirm_kwargs(self.option, default)
+
+    def prompt_kwargs(self, default: t.Any) -> dict[str, t.Any]:
+        """The keyword arguments of :func:`click.prompt` for an option that
+        is not a boolean flag, given the default from :meth:`get_default`.
+        """
+        return _prompt_kwargs(self.option, self.ctx, default)
+
+    def ask(self) -> t.Any:
+        """Prompt and return the processed value: :func:`click.confirm`
+        for a boolean flag, :func:`click.prompt` for any other option.
+        """
+        assert self.option.prompt is not None
+        default = self.get_default()
+
+        if self.option.is_bool_flag:
+            return termui.confirm(self.option.prompt, **self.confirm_kwargs(default))
+
+        return termui.prompt(self.option.prompt, **self.prompt_kwargs(default))
+
+
+# The two calls as ``Option.prompt_for_value`` made them, with the option as
+# ``self``; ``confirm`` and ``prompt`` here only collect their arguments.
+
+
+def _confirm_kwargs(self: Option, default: bool | None) -> dict[str, t.Any]:
+    def confirm(text: str | None, default: bool | None, **kwargs: t.Any) -> dict[str, t.Any]:
+        return {"default": default, **kwargs}
+
+    return confirm(self.prompt, default, max_attempts=self.prompt_attempts)
+
+
+def _prompt_kwargs(self: Option, ctx: Context, default: t.Any) -> dict[str, t.Any]:
+    def prompt(text: str | None, **kwargs: t.Any) -> dict[str, t.Any]:
+        return kwargs
+
+    # If show_default is given, provide this to `prompt` as well,
+    # otherwise we use `prompt`'s default behavior
+    prompt_kwargs: t.Any = {}
+    if self.show_default is not None:
+        prompt_kwargs["show_default"] = self.show_default
+
+    return prompt(
+        self.prompt,
+        # Use ``None`` to inform the prompt() function to reiterate until a valid
+        # value is provided by the user if we have no default.
+        default=self._hide_unset(default),
+        type=self.type,
+        hide_input=self.hide_input,
+        show_choices=self.show_choices,
+        confirmation_prompt=self.confirmation_prompt,
+        value_proc=lambda x: self.process_value(ctx, x),
+        max_attempts=self.prompt_attempts,
+        choice_menu=self.prompt_menu,
+        **prompt_kwargs,
+    )
