+class SecretStr:
+    """A string that keeps its value out of output: ``str()`` and ``repr()``
+    show ``***``, so echoing it, logging it or putting it in an error
+    message does not leak it. :meth:`reveal` returns the value.
+
+    Two secrets are equal when their values are equal. A secret is true
+    when its value is not empty, and its ``len`` is that of its value.
+
+    .. versionadded:: 8.6
+    """
+
+    __slots__ = ("_value",)
+
+    def __init__(self, value: str) -> None:
+        self._value = str(value)
+
+    def reveal(self) -> str:
+        """The value of the secret."""
+        return self._value
+
+    def __str__(self) -> str:
+        return "***"
+
+    def __repr__(self) -> str:
+        return "SecretStr('***')"
+
+    def __eq__(self, other: object) -> bool:
+        if isinstance(other, SecretStr):
+            return self._value == other._value
+
+        return NotImplemented
+
+    def __hash__(self) -> int:
+        return hash(self._value)
+
+    def __len__(self) -> int:
+        return len(self._value)
+
+    def __bool__(self) -> bool:
+        return bool(self._value)
+
+
+class Secret(ParamType[SecretStr]):
+    """A text value that must not be shown: a password, a token, a key.
+    The value is a :class:`SecretStr`. An option of this type hides its
+    input when it prompts and never shows its default, the same as an
+    option with ``hide_input=True``.
+
+    .. versionadded:: 8.6
+    """
+
+    name = "secret"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> SecretStr:
+        if isinstance(value, SecretStr):
+            return value
+
+        return SecretStr(STRING.convert(value, param, ctx))
+
+    def get_metavar(self, param: Parameter, ctx: Context) -> str | None:
+        return "SECRET"
+
+    def __repr__(self) -> str:
+        return "SECRET"
+
