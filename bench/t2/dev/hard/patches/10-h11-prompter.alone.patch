+"""The prompt loops: what :func:`click.prompt` and :func:`click.confirm` do
+after they have built their text, from reading an answer to returning a
+value.
+
+:class:`Prompter` holds the settings of one prompt. :func:`click.prompt`
+is ``Prompter(...).ask()`` and :func:`click.confirm` is
+``Prompter.confirm(...)``, so a subclass can change how an answer is
+read and keep the rest.
+"""
+
+from __future__ import annotations
+
+import sys
+import typing as t
+from contextlib import redirect_stdout
+from gettext import gettext as _
+
+from . import _compat
+from . import termui
+from ._compat import strip_ansi
+from .exceptions import Abort
+from .exceptions import UsageError
+from .globals import resolve_color_default
+from .types import convert_type
+from .types import ParamType
+from .utils import echo
+
+
+class Prompter:
+    """One prompt for a value: its settings and its loop.
+
+    The parameters are those of :func:`click.prompt`, in the same order and
+    with the same meaning; ``click.prompt(...)`` is
+    ``Prompter(...).ask()``.
+
+    The answers are read with :func:`click.termui.visible_prompt_func` or
+    :func:`click.termui.hidden_prompt_func`, looked up each time an answer
+    is read, so code that replaces them (such as :class:`click.testing.CliRunner`)
+    still works.
+
+    .. versionadded:: 8.6
+    """
+
+    def __init__(
+        self,
+        text: str,
+        default: t.Any | None = None,
+        hide_input: bool = False,
+        confirmation_prompt: bool | str = False,
+        type: ParamType[t.Any] | t.Any | None = None,
+        value_proc: t.Callable[[str], t.Any] | None = None,
+        prompt_suffix: str = ": ",
+        show_default: bool | str = True,
+        err: bool = False,
+        show_choices: bool = True,
+    ) -> None:
+        self.text = text
+        self.default = default
+        self.hide_input = hide_input
+        self.confirmation_prompt = confirmation_prompt
+        self.type = type
+        self.value_proc = value_proc
+        self.prompt_suffix = prompt_suffix
+        self.show_default = show_default
+        self.err = err
+        self.show_choices = show_choices
+
+    @staticmethod
+    def readline(func: t.Callable[[str], str], text: str, err: bool) -> str:
+        """Call a prompt function, passing the full prompt so readline can
+        handle line editing and cursor positioning correctly.
+
+        The prompt is handed to *func* (such as :func:`input`) rather than
+        written through :func:`echo`, so it has to strip ANSI color and style
+        codes itself when the destination stream does not support them.
+        Without this the prompt would keep codes that :func:`echo` removes
+        from the rest of the output.
+        """
+        stream = sys.stderr if err else sys.stdout
+
+        # Look up ``should_strip_ansi`` on the module so that ``CliRunner``,
+        # which patches it there during test isolation, is honored.
+        if _compat.should_strip_ansi(stream, resolve_color_default()):
+            text = strip_ansi(text)
+
+        if err:
+            with redirect_stdout(sys.stderr):
+                return func(text)
+        return func(text)
+
+    def read(self, text: str) -> str:
+        """Read one answer to ``text``, hidden when :attr:`hide_input` is
+        set. An interrupt or the end of the input raises :exc:`Abort`.
+        """
+        f = termui.hidden_prompt_func if self.hide_input else termui.visible_prompt_func
+        try:
+            return type(self).readline(f, text, self.err)
+        except (KeyboardInterrupt, EOFError):
+            # getpass doesn't print a newline if the user aborts input with ^C.
+            # Allegedly this behavior is inherited from getpass(3).
+            # A doc bug has been filed at https://bugs.python.org/issue24711
+            if self.hide_input:
+                echo(None, err=self.err)
+            raise Abort() from None
+
+    def ask(self) -> t.Any:
+        """Ask until the answer is valid and return the converted value."""
+        default = self.default
+        value_proc = self.value_proc
+
+        if value_proc is None:
+            value_proc = convert_type(self.type, default)
+
+        prompt = termui._build_prompt(
+            self.text,
+            self.prompt_suffix,
+            self.show_default,
+            default,
+            self.show_choices,
+            self.type,
+        )
+        confirmation_prompt = self.confirmation_prompt
+
+        if confirmation_prompt:
+            if confirmation_prompt is True:
+                confirmation_prompt = _("Repeat for confirmation")
+
+            confirmation_prompt = termui._build_prompt(
+                confirmation_prompt, self.prompt_suffix
+            )
+
+        while True:
+            while True:
+                value = self.read(prompt)
+                if value:
+                    break
+                elif default is not None:
+                    # Defaults of any type are accepted and round trip through
+                    # value_proc like typed input, so the annotation is only
+                    # accurate for typed input.
+                    value = t.cast("str", default)
+                    break
+            try:
+                result = value_proc(value)
+            except UsageError as e:
+                message = (
+                    termui._mask_hidden_input(e.message, value)
+                    if self.hide_input
+                    else e.message
+                )
+                echo(_("Error: {message}").format(message=message), err=self.err)
+                continue
+            if not confirmation_prompt:
+                return result
+            while True:
+                value2 = self.read(confirmation_prompt)
+                is_empty = not value and not value2
+                if value2 or is_empty:
+                    break
+            if value == value2:
+                return result
+            echo(_("Error: The two entered values do not match."), err=self.err)
+
+    @classmethod
+    def confirm(
+        cls,
+        text: str,
+        default: bool | None = False,
+        abort: bool = False,
+        prompt_suffix: str = ": ",
+        show_default: bool = True,
+        err: bool = False,
+    ) -> bool:
+        """Ask a yes/no question; the parameters are those of
+        :func:`click.confirm`, and ``click.confirm(...)`` is
+        ``Prompter.confirm(...)``.
+        """
+        prompt = termui._build_prompt(
+            text,
+            prompt_suffix,
+            show_default,
+            "y/n" if default is None else ("Y/n" if default else "y/N"),
+        )
+
+        while True:
+            try:
+                value = (
+                    cls.readline(termui.visible_prompt_func, prompt, err)
+                    .lower()
+                    .strip()
+                )
+            except (KeyboardInterrupt, EOFError):
+                raise Abort() from None
+            if value in ("y", "yes"):
+                rv = True
+            elif value in ("n", "no"):
+                rv = False
+            elif default is not None and value == "":
+                rv = default
+            else:
+                echo(_("Error: invalid input"), err=err)
+                continue
+            break
+        if abort and not rv:
+            raise Abort()
+        return rv
