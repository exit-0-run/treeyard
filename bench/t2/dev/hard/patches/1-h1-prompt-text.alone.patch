+"""The text of a prompt: what :func:`click.prompt` and :func:`click.confirm`
+show before they read an answer.
+
+The text is built from parts (the question, the choices, the default and the
+suffix) by :class:`PromptText`. Each part has its own method, so a subclass
+can change one part and keep the others.
+"""
+
+from __future__ import annotations
+
+import io
+import typing as t
+
+from .types import Choice
+from .utils import _LazyFile
+
+V = t.TypeVar("V")
+
+
+def _format_default(default: V) -> V | str:
+    """The default as a prompt shows it: an open file by its name, anything
+    else as it is.
+    """
+    if isinstance(default, (io.IOBase, _LazyFile)):
+        name = getattr(default, "name", None)
+
+        if name is not None:
+            return str(name)
+
+    return default
+
+
+class PromptText:
+    """The text of one prompt, built from its parts.
+
+    ``PromptText("Name", ": ", default="alice").render()`` is
+    ``"Name [alice]: "``, exactly the text that
+    ``click.prompt("Name", default="alice")`` shows.
+
+    :param text: the question.
+    :param suffix: written after everything else, such as ``": "``.
+    :param show_default: show the default in brackets. A string is shown
+        in parentheses instead of the default itself.
+    :param default: the default value.
+    :param show_choices: list the choices of a :class:`Choice` type.
+    :param type: the type of the value that is asked for.
+
+    .. versionadded:: 8.6
+    """
+
+    def __init__(
+        self,
+        text: str,
+        suffix: str = ": ",
+        show_default: bool | str = False,
+        default: object | None = None,
+        show_choices: bool = True,
+        type: object | None = None,
+    ) -> None:
+        self.text = text
+        self.suffix = suffix
+        self.show_default = show_default
+        self.default = default
+        self.show_choices = show_choices
+        self.type = type
+
+    @classmethod
+    def for_confirm(
+        cls,
+        text: str,
+        default: bool | None = False,
+        suffix: str = ": ",
+        show_default: bool = True,
+    ) -> PromptText:
+        """The text of a yes/no question, as :func:`click.confirm` asks it:
+        the default is shown as ``y/n``, ``Y/n`` or ``y/N``.
+        """
+        if default is None:
+            hint = "y/n"
+        elif default:
+            hint = "Y/n"
+        else:
+            hint = "y/N"
+
+        return cls(text, suffix, show_default, hint)
+
+    def choices_part(self) -> str:
+        """The choices of a :class:`Choice` type in parentheses, with a
+        leading space, or ``""``.
+        """
+        if self.type is None or not self.show_choices:
+            return ""
+
+        if not isinstance(self.type, Choice):
+            return ""
+
+        return f" ({', '.join(map(str, self.type.choices))})"
+
+    def default_part(self) -> str:
+        """The default in brackets, with a leading space, or ``""``."""
+        if not self.show_default:
+            return ""
+
+        if isinstance(self.show_default, str):
+            return f" [({self.show_default})]"
+
+        if self.default is None:
+            return ""
+
+        return f" [{_format_default(self.default)}]"
+
+    def render(self) -> str:
+        """The whole text: the question, the choices, the default and the
+        suffix.
+        """
+        return f"{self.text}{self.choices_part()}{self.default_part()}{self.suffix}"
+
+    def __str__(self) -> str:
+        return self.render()
+
+    def __repr__(self) -> str:
+        return f"<{type(self).__name__} {self.render()!r}>"
