diff --git a/networkx/readwrite/_floats.py b/networkx/readwrite/_floats.py
new file mode 100644
index 0000000..82a84a3
--- /dev/null
+++ b/networkx/readwrite/_floats.py
@@ -0,0 +1,25 @@
+"""The text of edge data for the line formats, with ``float_format``."""
+
+__all__ = []
+
+
+def value_text(value, float_format=None):
+    """``str(value)``, or ``format(value, float_format)`` for a float when
+    `float_format` is given."""
+    if float_format is not None and isinstance(value, float):
+        return format(value, float_format)
+    return str(value)
+
+
+def data_text(data, float_format=None):
+    """The text of an edge data dict: ``str(dict(data))``; with
+    `float_format`, float values are written with it and keys and other values
+    with ``repr`` as ``str`` of a dict does."""
+    data = dict(data)
+    if float_format is None:
+        return str(data)
+    items = []
+    for key, value in data.items():
+        text = format(value, float_format) if isinstance(value, float) else repr(value)
+        items.append(f"{key!r}: {text}")
+    return "{" + ", ".join(items) + "}"
diff --git a/networkx/readwrite/_sorting.py b/networkx/readwrite/_sorting.py
new file mode 100644
index 0000000..6c31c20
--- /dev/null
+++ b/networkx/readwrite/_sorting.py
@@ -0,0 +1,41 @@
+"""Sorted output for the line formats (``sort=True`` or a key function)."""
+
+__all__ = []
+
+
+def sorted_graph(G, sort=True):
+    """A copy of `G` whose nodes, neighbours and edge keys are in sorted order,
+    so that writing it does not depend on the order in which nodes and edges
+    were added.
+
+    Nodes are sorted by ``str(node)``, or by ``sort(node)`` when `sort` is a
+    function; ties keep the order of `G`. In an undirected graph each edge is
+    stored from the end that comes first, so the line formats write it there.
+    Edges are in the order of their ends, parallel edges in the order of
+    ``str(key)``.
+    """
+    key = sort if callable(sort) else str
+    H = G.__class__()
+    H.graph.update(G.graph)
+    nodes = sorted(G, key=key)
+    rank = {n: i for i, n in enumerate(nodes)}
+    for n in nodes:
+        H.add_node(n, **G.nodes[n])
+    directed = G.is_directed()
+
+    def ends(u, v):
+        if directed or rank[u] <= rank[v]:
+            return u, v
+        return v, u
+
+    if G.is_multigraph():
+        edges = [(*ends(u, v), k, d) for u, v, k, d in G.edges(keys=True, data=True)]
+        edges.sort(key=lambda e: (rank[e[0]], rank[e[1]], str(e[2])))
+        for u, v, k, d in edges:
+            H.add_edge(u, v, key=k, **d)
+    else:
+        edges = [(*ends(u, v), d) for u, v, d in G.edges(data=True)]
+        edges.sort(key=lambda e: (rank[e[0]], rank[e[1]]))
+        for u, v, d in edges:
+            H.add_edge(u, v, **d)
+    return H
