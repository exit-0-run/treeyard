new file mode 100644
index 0000000..6c31c20
--- /dev/null
+++ b/networkx/readwrite/_sorting.py
@@ -0,0 +1,41 @@
+"""Sorted output for the line formats (``sort=True`` or a key function)."""
+
+__all__ = []
+
+
+def sorted_graph(G, sort=True):
+    """A copy of `G` whose nodes, neighbours and edge keys are in sorted order,
+    so that writing it does not depend on the order in which nodes and edges
+    were added.
+
+    Nodes are sorted by ``str(node)``, or by ``sort(node)`` when `sort` is a
+    function; ties keep the order of `G`. In an undirected graph each edge is
+    stored from the end that comes first, so the line formats write it there.
+    Edges are in the order of their ends, parallel edges in the order of
+    ``str(key)``.
+    """
+    key = sort if callable(sort) else str
+    H = G.__class__()
+    H.graph.update(G.graph)
+    nodes = sorted(G, key=key)
+    rank = {n: i for i, n in enumerate(nodes)}
+    for n in nodes:
+        H.add_node(n, **G.nodes[n])
+    directed = G.is_directed()
+
+    def ends(u, v):
+        if directed or rank[u] <= rank[v]:
+            return u, v
+        return v, u
+
+    if G.is_multigraph():
+        edges = [(*ends(u, v), k, d) for u, v, k, d in G.edges(keys=True, data=True)]
+        edges.sort(key=lambda e: (rank[e[0]], rank[e[1]], str(e[2])))
+        for u, v, k, d in edges:
+            H.add_edge(u, v, key=k, **d)
+    else:
+        edges = [(*ends(u, v), d) for u, v, d in G.edges(data=True)]
+        edges.sort(key=lambda e: (rank[e[0]], rank[e[1]]))
+        for u, v, d in edges:
+            H.add_edge(u, v, **d)
+    return H
