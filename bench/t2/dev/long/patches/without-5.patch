+def parse_graph_header(lines, comments="#"):
+    """The graph header of the lines of a file in the edge list, adjacency
+    list or multiline adjacency list format.
+
+    Parameters
+    ----------
+    lines : iterable of str
+       The lines of the file.
+    comments : str, optional (default="#")
+       The comment string of the file.
+
+    Returns
+    -------
+    dict or None
+       ``{"directed": bool, "multigraph": bool, "name": str or None}`` when a
+       header line (as written with ``header=True``) comes before the first
+       data line, else None. Reading stops at the first data line.
+
+    Examples
+    --------
+    >>> nx.parse_graph_header(
+    ...     ["# networkx-graph: directed=True multigraph=False", "1 2"]
+    ... )
+    {'directed': True, 'multigraph': False, 'name': None}
+
+    See Also
+    --------
+    read_graph_header
+    """
+    for line in lines:
+        info = parse_header(line, comments)
+        if info is not None:
+            return info
+        text = line.strip()
+        if text and not (comments is not None and text.startswith(comments)):
+            return None
+    return None
+
