index 0000000..ced70af
--- /dev/null
+++ b/networkx/readwrite/_compression.py
@@ -0,0 +1,56 @@
+"""Compressed files for the line formats (edge list, adjacency lists, Pajek,
+LEDA).
+
+The readers recognise a gzip, bz2 or xz file by its first bytes, whatever its
+name; the writers compress with ``compression="gzip"``, ``"bz2"`` or ``"xz"``.
+"""
+
+import bz2
+import gzip
+import io
+import lzma
+
+__all__ = []
+
+# The first bytes of each kind of compressed file.
+MAGIC = ((b"\x1f\x8b", gzip), (b"BZh", bz2), (b"\xfd7zXZ\x00", lzma))
+COMPRESSIONS = {"gzip": gzip.GzipFile, "bz2": bz2.BZ2File, "xz": lzma.LZMAFile}
+
+
+def uncompressed(f):
+    """The open binary file `f`, uncompressed when its content is gzip, bz2 or
+    xz data (several compressions in a row are all undone). A file of text
+    lines (``str``) is returned as it is."""
+    data = f.read()
+    if isinstance(data, str):
+        return io.StringIO(data)
+    while True:
+        for magic, module in MAGIC:
+            if data.startswith(magic):
+                data = module.decompress(data)
+                break
+        else:
+            return io.BytesIO(data)
+
+
+def compressing(f, compression):
+    """``(writer, finish)``: the file to write to and the function to call when
+    all is written. With `compression` None they are `f` and a no-op; else a
+    writer that compresses into `f` (which stays open)."""
+    if compression is None:
+        return f, lambda: None
+    if compression not in COMPRESSIONS:
+        raise ValueError(
+            f"compression must be None, 'gzip', 'bz2' or 'xz', not {compression!r}"
+        )
+    if isinstance(f, (gzip.GzipFile, bz2.BZ2File, lzma.LZMAFile)):
+        # a file name ending in .gz, .gzip, .bz2 or .xz: open_file compresses already
+        raise ValueError(
+            f"compression={compression!r} for a file whose name ending compresses already"
+        )
+    writer = (
+        COMPRESSIONS[compression](f, mode="wb")
+        if compression != "gzip"
+        else gzip.GzipFile(fileobj=f, mode="wb")
+    )
+    return writer, writer.close
diff --git a/networkx/readwrite/_floats.py b/networkx/readwrite/_floats.py
