index 0000000..246ecc3
--- /dev/null
+++ b/networkx/readwrite/_encoding.py
@@ -0,0 +1,63 @@
+"""Byte order marks and encoding detection for the line formats."""
+
+import codecs
+import re
+
+__all__ = []
+
+_BOMS = (
+    (codecs.BOM_UTF8, "utf-8"),
+    (codecs.BOM_UTF16_LE, "utf-16-le"),
+    (codecs.BOM_UTF16_BE, "utf-16-be"),
+)
+
+
+def _canonical(encoding):
+    return codecs.lookup(encoding).name
+
+
+def decoded_lines(f, encoding="utf-8"):
+    """The lines of the open file `f` as text, line ends kept.
+
+    A UTF-8 byte order mark at the start is skipped when the encoding is
+    UTF-8. With ``encoding=None`` the encoding comes from the byte order mark
+    (UTF-8, UTF-16 LE or UTF-16 BE), UTF-8 when there is none.
+    """
+    if encoding is None:
+        data = f.read()
+        if isinstance(data, str):
+            return iter(_lines(data.removeprefix("﻿")))
+        encoding = "utf-8"
+        for bom, name in _BOMS:
+            if data.startswith(bom):
+                data, encoding = data[len(bom) :], name
+                break
+        return iter(_lines(data.decode(encoding)))
+    utf8 = _canonical(encoding) == "utf-8"
+
+    def gen():
+        first = True
+        for line in f:
+            if not isinstance(line, str):
+                line = line.decode(encoding)
+            if first and utf8:
+                line = line.removeprefix("﻿")
+            first = False
+            yield line
+
+    return gen()
+
+
+def _lines(text):
+    return re.findall(r"[^\n]*\n|[^\n]+\Z", text)
+
+
+def bom_bytes(encoding):
+    """The byte order mark of `encoding` for ``bom=True``."""
+    name = _canonical(encoding)
+    for bom, bom_name in _BOMS:
+        if name == bom_name:
+            return bom
+    raise ValueError(
+        f"bom=True needs the encoding utf-8, utf-16-le or utf-16-be, not {encoding!r}"
+    )
