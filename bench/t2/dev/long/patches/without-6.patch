index 0000000..c225ca9
--- /dev/null
+++ b/networkx/readwrite/_newlines.py
@@ -0,0 +1,31 @@
+"""Line ends for the line formats: ``\\n``, ``\\r\\n`` or ``\\r``."""
+
+import re
+
+__all__ = []
+
+NEWLINES = ("\n", "\r\n", "\r")
+
+_END = re.compile(r"[^\r\n]*(?:\r\n|\r|\n)|[^\r\n]+\Z")
+
+
+def split_line_ends(lines):
+    """The lines of `lines` (text pieces as a file yields them), split again at
+    every ``\\r\\n``, ``\\r`` or ``\\n``, each with its line end."""
+    rest = ""
+    for piece in lines:
+        text = rest + piece
+        rest = ""
+        parts = _END.findall(text)
+        if parts and parts[-1].endswith("\r") and text.endswith("\r"):
+            # a "\r" at the end of a piece may be the first half of "\r\n"
+            rest = parts.pop()
+        yield from parts
+    if rest:
+        yield rest
+
+
+def check_newline(newline):
+    """Raises ValueError unless `newline` is ``"\\n"``, ``"\\r\\n"`` or ``"\\r"``."""
+    if newline not in NEWLINES:
+        raise ValueError(f'newline must be "\\n", "\\r\\n" or "\\r", not {newline!r}')
diff --git a/networkx/readwrite/_quote.py b/networkx/readwrite/_quote.py
new file mode 100644
index 0000000..cc9e9fb
--- /dev/null
+++ b/networkx/readwrite/_quote.py
@@ -0,0 +1,139 @@
+"""Quoted node names for the line formats (edge list, adjacency lists).
+
+A node name that cannot be written as a bare token is written in double
+quotes. Inside the quotes a backslash is written as ``\\\\``, a double quote
+as ``\\"``, a line feed as ``\\n`` and a carriage return as ``\\r``.
+"""
+
+__all__ = []
+
+# The escapes inside a quoted name: a line break would end the line.
+_ESCAPES = {"n": "\n", "r": "\r"}
+
+
+def needs_quotes(name, delimiter=" "):
+    """True when the text `name` cannot be written as a bare token: it is
+    empty, or holds whitespace, the delimiter, ``#``, ``"`` or ``\\``."""
+    if name == "":
+        return True
+    if any(c.isspace() for c in name):
+        return True
+    if delimiter and delimiter in name:
+        return True
+    return any(c in name for c in '#"\\')
+
+
+def quote_name(node, delimiter=" "):
+    """The text of a node for a line format: ``str(node)``, in double quotes
+    when it needs them (see :func:`needs_quotes`)."""
+    name = str(node)
+    if not needs_quotes(name, delimiter):
+        return name
+    text = name.replace("\\", "\\\\").replace('"', '\\"')
+    text = text.replace("\n", "\\n").replace("\r", "\\r")
+    return '"' + text + '"'
+
+
+def split_names(line, delimiter=None, names=None):
+    """Split `line` into tokens at `delimiter` (runs of whitespace when it is
+    None). The first `names` tokens (all when `names` is None) are node names
+    and may be quoted; they are returned unquoted. The remaining tokens are
+    split as ``str.split`` does.
+
+    Raises ``TypeError`` for a quote that is not closed, or for text right
+    after a closing quote.
+    """
+    tokens = []
+    i = 0
+    n = len(line)
+
+    def skip_delimiter(i):
+        if delimiter is None:
+            while i < n and line[i].isspace():
+                i += 1
+            return i
+        if line.startswith(delimiter, i):
+            return i + len(delimiter)
+        return i
+
+    if delimiter is None:
+        i = skip_delimiter(0)
+    while i < n and (names is None or len(tokens) < names):
+        if line[i] == '"':
+            j = i + 1
+            chars = []
+            while j < n and line[j] != '"':
+                if line[j] == "\\" and j + 1 < n:
+                    j += 1
+                    chars.append(_ESCAPES.get(line[j], line[j]))
+                    j += 1
+                    continue
+                chars.append(line[j])
+                j += 1
+            if j >= n:
+                raise TypeError(f"Unclosed quote in line ({line})")
+            j += 1
+            if j < n:
+                rest = line[j:]
+                at_delim = (
+                    rest[0].isspace()
+                    if delimiter is None
+                    else rest.startswith(delimiter)
+                )
+                if not at_delim:
+                    raise TypeError(f"Text after a closing quote in line ({line})")
+            tokens.append("".join(chars))
+            i = skip_delimiter(j)
+            if delimiter is not None and j == n:
+                break
+        else:
+            if delimiter is None:
+                j = i
+                while j < n and not line[j].isspace():
+                    j += 1
+            else:
+                j = line.find(delimiter, i)
+                if j < 0:
+                    j = n
+            tokens.append(line[i:j])
+            if j >= n:
+                i = n
+                break
+            i = skip_delimiter(j)
+            if delimiter is not None and i == n:
+                tokens.append("")
+                break
+    if i < n:
+        tokens.extend(line[i:].split(delimiter))
+    return tokens
+
+
+def strip_comment(line, comments="#", delimiter=None):
+    """`line` without its comment: the text from the first `comments` string
+    that is not inside a quoted name. A quoted name starts with ``"`` at the
+    start of a token."""
+    if comments is None:
+        return line
+    i = 0
+    n = len(line)
+    at_token_start = True
+    while i < n:
+        if line.startswith(comments, i):
+            return line[:i]
+        c = line[i]
+        if c == '"' and at_token_start:
+            j = i + 1
+            while j < n and line[j] != '"':
+                j += 2 if line[j] == "\\" else 1
+            i = j + 1
+            at_token_start = False
+            continue
+        if delimiter is None:
+            at_token_start = c.isspace()
+        else:
+            at_token_start = line.startswith(delimiter, i)
+            if at_token_start:
+                i += len(delimiter)
+                continue
+        i += 1
+    return line
diff --git a/networkx/readwrite/_sorting.py b/networkx/readwrite/_sorting.py
new file mode 100644
index 0000000..6c31c20
--- /dev/null
+++ b/networkx/readwrite/_sorting.py
@@ -0,0 +1,41 @@
+"""Sorted output for the line formats (``sort=True`` or a key function)."""
+
+__all__ = []
+
+
+def sorted_graph(G, sort=True):
+    """A copy of `G` whose nodes, neighbours and edge keys are in sorted order,
+    so that writing it does not depend on the order in which nodes and edges
+    were added.
+
+    Nodes are sorted by ``str(node)``, or by ``sort(node)`` when `sort` is a
+    function; ties keep the order of `G`. In an undirected graph each edge is
+    stored from the end that comes first, so the line formats write it there.
+    Edges are in the order of their ends, parallel edges in the order of
+    ``str(key)``.
+    """
+    key = sort if callable(sort) else str
+    H = G.__class__()
+    H.graph.update(G.graph)
+    nodes = sorted(G, key=key)
+    rank = {n: i for i, n in enumerate(nodes)}
+    for n in nodes:
+        H.add_node(n, **G.nodes[n])
+    directed = G.is_directed()
+
+    def ends(u, v):
+        if directed or rank[u] <= rank[v]:
+            return u, v
+        return v, u
+
+    if G.is_multigraph():
+        edges = [(*ends(u, v), k, d) for u, v, k, d in G.edges(keys=True, data=True)]
+        edges.sort(key=lambda e: (rank[e[0]], rank[e[1]], str(e[2])))
+        for u, v, k, d in edges:
+            H.add_edge(u, v, key=k, **d)
+    else:
+        edges = [(*ends(u, v), d) for u, v, d in G.edges(data=True)]
+        edges.sort(key=lambda e: (rank[e[0]], rank[e[1]]))
+        for u, v, d in edges:
+            H.add_edge(u, v, **d)
+    return H
diff --git a/networkx/readwrite/_textfile.py b/networkx/readwrite/_textfile.py
new file mode 100644
index 0000000..1ac0d8f
--- /dev/null
+++ b/networkx/readwrite/_textfile.py
@@ -0,0 +1,95 @@
+"""The files of the text formats: opening them, decoding the lines read and
+encoding the lines written.
+
+The ``read_*`` and ``write_*`` functions of the edge list, adjacency list,
+multiline adjacency list, Pajek and LEDA formats open, read and write their
+file only through :class:`TextFile`: ``read_edgelist(path, ...)`` is
+``TextFile(encoding).read(path, parse_edgelist, ...)`` and
+``write_edgelist(G, path, ...)`` is ``TextFile(encoding, ...).write(path,
+lines)``. GML, graph6, sparse6, GraphML and GEXF open their file with
+:meth:`TextFile.open` too.
+"""
+
+from contextlib import contextmanager
+from os.path import splitext
+from pathlib import Path
+
+from networkx.exception import LineParseError
+from networkx.readwrite._encoding import bom_bytes, decoded_lines
+from networkx.readwrite._newlines import check_newline, split_line_ends
+
+__all__ = ["TextFile"]
+
+
+class TextFile:
+    """How the text formats open, read and write their files.
+
+    Parameters
+    ----------
+    encoding : str or None, optional (default="utf-8")
+        The text encoding of the file.
+    bom : bool, optional (default=False)
+        Write the byte order mark of `encoding` first.
+    newline : str, optional (default="\\n")
+        The line end written after each line.
+
+    .. versionadded:: 3.8
+    """
+
+    def __init__(self, encoding="utf-8", bom=False, newline="\n"):
+        self.encoding = encoding
+        self.bom = bom
+        self.newline = newline
+
+    @contextmanager
+    def open(self, path, mode):
+        """The binary file `path` opened in `mode` (``"rb"`` or ``"wb"``), as
+        :func:`networkx.utils.open_file` opens it: a file name or
+        :class:`~pathlib.Path` is opened (through the compression its ending
+        names) and closed afterwards; an open file is used as it is and stays
+        open."""
+        from networkx.utils.decorators import _dispatch_dict
+
+        if isinstance(path, (str, Path)):
+            name = str(path)
+            f = _dispatch_dict[splitext(name)[1]](name, mode=mode)
+            try:
+                yield f
+            finally:
+                f.close()
+        else:
+            yield path
+
+    def read_lines(self, f):
+        """The lines of the open binary file `f` as text, each with its line
+        end (lines that are already text pass as they are)."""
+        encoding = self.encoding
+        return split_line_ends(decoded_lines(f, encoding))
+
+    def write_lines(self, f, lines):
+        """Writes each of `lines` (text without line ends) to the open binary
+        file `f`, each followed by the line end."""
+        encoding = self.encoding
+        newline = self.newline
+        check_newline(newline)
+        if self.bom:
+            f.write(bom_bytes(encoding))
+        for line in lines:
+            line += newline
+            f.write(line.encode(encoding))
+
+    def read(self, path, parse, *args, **kwargs):
+        """``parse(lines, *args, **kwargs)`` of the lines of the file `path`:
+        it is opened with :meth:`open` and read with :meth:`read_lines`."""
+        with self.open(path, "rb") as f:
+            try:
+                return parse(self.read_lines(f), *args, **kwargs)
+            except LineParseError as err:
+                err.filename = getattr(f, "name", None)
+                raise
+
+    def write(self, path, lines):
+        """Writes `lines` to the file `path`: it is opened with :meth:`open`
+        and written with :meth:`write_lines`."""
+        with self.open(path, "wb") as f:
+            self.write_lines(f, lines)
