+"""The files of the text formats: opening them, decoding the lines read and
+encoding the lines written.
+
+The ``read_*`` and ``write_*`` functions of the edge list, adjacency list,
+multiline adjacency list, Pajek and LEDA formats open, read and write their
+file only through :class:`TextFile`: ``read_edgelist(path, ...)`` is
+``TextFile(encoding).read(path, parse_edgelist, ...)`` and
+``write_edgelist(G, path, ...)`` is ``TextFile(encoding, ...).write(path,
+lines)``. GML, graph6, sparse6, GraphML and GEXF open their file with
+:meth:`TextFile.open` too.
+"""
+
+from contextlib import contextmanager
+from os.path import splitext
+from pathlib import Path
+
+from networkx.exception import LineParseError
+from networkx.readwrite._compression import uncompressed, compressing
+from networkx.readwrite._encoding import bom_bytes, decoded_lines
+from networkx.readwrite._newlines import check_newline, split_line_ends
+
+__all__ = ["TextFile"]
+
+
+class TextFile:
+    """How the text formats open, read and write their files.
+
+    Parameters
+    ----------
+    encoding : str or None, optional (default="utf-8")
+        The text encoding of the file.
+    bom : bool, optional (default=False)
+        Write the byte order mark of `encoding` first.
+    newline : str, optional (default="\\n")
+        The line end written after each line.
+    compression : {None, "gzip", "bz2", "xz"}, optional (default=None)
+        Compress what is written.
+
+    .. versionadded:: 3.8
+    """
+
+    def __init__(self, encoding="utf-8", bom=False, newline="\n", compression=None):
+        self.encoding = encoding
+        self.bom = bom
+        self.newline = newline
+        self.compression = compression
+
+    @contextmanager
+    def open(self, path, mode):
+        """The binary file `path` opened in `mode` (``"rb"`` or ``"wb"``), as
+        :func:`networkx.utils.open_file` opens it: a file name or
+        :class:`~pathlib.Path` is opened (through the compression its ending
+        names) and closed afterwards; an open file is used as it is and stays
+        open."""
+        from networkx.utils.decorators import _dispatch_dict
+
+        if isinstance(path, (str, Path)):
+            name = str(path)
+            f = _dispatch_dict[splitext(name)[1]](name, mode=mode)
+            try:
+                yield f
+            finally:
+                f.close()
+        else:
+            yield path
+
+    def read_lines(self, f):
+        """The lines of the open binary file `f` as text, each with its line
+        end (lines that are already text pass as they are)."""
+        encoding = self.encoding
+        return split_line_ends(decoded_lines(uncompressed(f), encoding))
+
+    def write_lines(self, f, lines):
+        """Writes each of `lines` (text without line ends) to the open binary
+        file `f`, each followed by the line end."""
+        encoding = self.encoding
+        newline = self.newline
+        check_newline(newline)
+        f, finish = compressing(f, self.compression)
+        if self.bom:
+            f.write(bom_bytes(encoding))
+        for line in lines:
+            line += newline
+            f.write(line.encode(encoding))
+        finish()
+
+    def read(self, path, parse, *args, **kwargs):
+        """``parse(lines, *args, **kwargs)`` of the lines of the file `path`:
+        it is opened with :meth:`open` and read with :meth:`read_lines`."""
+        with self.open(path, "rb") as f:
+            try:
+                return parse(self.read_lines(f), *args, **kwargs)
+            except LineParseError as err:
+                err.filename = getattr(f, "name", None)
+                raise
+
+    def write(self, path, lines):
+        """Writes `lines` to the file `path`: it is opened with :meth:`open`
+        and written with :meth:`write_lines`."""
+        with self.open(path, "wb") as f:
+            self.write_lines(f, lines)
