index 0000000..eb32352
--- /dev/null
+++ b/networkx/readwrite/_sorting.py
@@ -0,0 +1,33 @@
+"""Sorted output for the line formats (``sort=True``)."""
+
+__all__ = []
+
+
+def sorted_graph(G):
+    """A copy of `G` whose nodes, neighbours and edge keys are in the order of
+    their ``str``, so that writing it does not depend on the order in which
+    nodes and edges were added. In an undirected graph each edge is stored
+    from the end whose ``str`` sorts first, so the line formats write it
+    there. Ties keep the order of `G`."""
+    H = G.__class__()
+    H.graph.update(G.graph)
+    for n in sorted(G, key=str):
+        H.add_node(n, **G.nodes[n])
+    directed = G.is_directed()
+
+    def ends(u, v):
+        if directed or str(u) <= str(v):
+            return u, v
+        return v, u
+
+    if G.is_multigraph():
+        edges = [(*ends(u, v), k, d) for u, v, k, d in G.edges(keys=True, data=True)]
+        edges.sort(key=lambda e: (str(e[0]), str(e[1]), str(e[2])))
+        for u, v, k, d in edges:
+            H.add_edge(u, v, key=k, **d)
+    else:
+        edges = [(*ends(u, v), d) for u, v, d in G.edges(data=True)]
+        edges.sort(key=lambda e: (str(e[0]), str(e[1])))
+        for u, v, d in edges:
+            H.add_edge(u, v, **d)
+    return H
